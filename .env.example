# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Required
JWT_SECRET=change-me-to-a-random-32-char-string

# Optional — enables live TMDB movie/series search
# Get a free key at https://developer.themoviedb.org
TMDB_API_KEY=

# Used by docker-compose (defaults work for local dev)
# DATABASE_URL=postgres://postgres:password@postgres:5432/movietracker?sslmode=disable
# REDIS_URL=redis://redis:6379
